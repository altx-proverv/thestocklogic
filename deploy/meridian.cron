# MERIDIAN — the IV recorder
# ==========================
# Install:  crontab -l > /tmp/ct && cat deploy/meridian.cron >> /tmp/ct \
#           && crontab /tmp/ct && crontab -l | tail -12
#
# WHY THIS RUNS AT ALL BEFORE THE REST OF MERIDIAN EXISTS. IV percentile needs a
# year of daily history and no API sells it retrospectively. Every other part of
# MERIDIAN can be built whenever; this one cannot be caught up, so it starts
# accumulating now and every night missed is gone for good.
#
# THE BOX RUNS UTC. IST = UTC + 5:30, and these are written in UTC.
#
# ── BOTH TIMES, FOR ONE SESSION, THEN PICK ONE ────────────────────
#
# The right snapshot time is not established. 15:45 IST is minutes after the
# close and reflects it; 18:35 IST follows the EOD chain; open interest settles
# somewhere between the two. Rather than guess and discover the answer in six
# months, both run for one session with --label distinguishing them, and every
# row carries snapshot_taken_at so the comparison is possible at all.
#
# Compare with:
#   select run_label, underlyings_written, india_vix, duration_s
#     from meridian_recorder_runs where trade_date = current_date;
#   select a.underlying_symbol, a.atm_iv close_iv, b.atm_iv eod_iv,
#          a.total_call_oi close_oi, b.total_call_oi eod_oi
#     from meridian_iv_daily a join meridian_iv_daily b
#       on b.underlying_symbol = a.underlying_symbol
#      and b.trade_date = a.trade_date
#    where a.snapshot_taken_at < b.snapshot_taken_at;
#
# AFTER THE COMPARISON, DELETE THE LINE YOU ARE NOT KEEPING. Leaving both costs
# ~436 API calls a night for one series, and the second write silently overwrites
# the first on the (trade_date, underlying_symbol) key -- so keeping both means
# the daily table holds whichever ran last, which is the opposite of a choice.

# 15:45 IST — minutes after the close
15 10 * * 1-5 cd /home/ubuntu/thestocklogic && /home/ubuntu/thestocklogic/venv/bin/python -m meridian.iv_recorder --label close >> /home/ubuntu/logs/meridian_iv_close.log 2>&1

# 18:35 IST — after the EOD chain
5 13 * * 1-5 cd /home/ubuntu/thestocklogic && /home/ubuntu/thestocklogic/venv/bin/python -m meridian.iv_recorder --label eod >> /home/ubuntu/logs/meridian_iv_eod.log 2>&1

# No staleness check here on purpose. It lives in atlas-engine-report (15:30 IST),
# which already runs every weekday for its own reasons -- a watchdog for a nightly
# job cannot live in that job, because the failure it guards against is the job
# never starting.
