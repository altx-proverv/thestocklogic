# ATLAS market-hours entry engine.
#
#   sudo cp deploy/atlas-market-hours.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now atlas-market-hours
#   journalctl -u atlas-market-hours -f
#
# This REPLACES the 09:37 market_open cron entry. Remove that line from the
# crontab when enabling this, or both will evaluate the same batch and the
# only thing standing between them is Gate 3b.
#
# SHADOW vs LIVE is atlas/config.py's LIVE_TRADING_ENABLED, not a unit setting.
# Nothing here turns on live trading.
#
# RESTART=ON-FAILURE, NOT ALWAYS.
#
# This process exits 0 when the window closes: its work for the day is done.
# Under Restart=always systemd reads that as "came back, start it again", so
# outside market hours it span -- start, see the window closed, exit, wait,
# start again, around the clock. Harmless in itself and genuinely bad for the
# thing that matters: a journal full of routine restarts is one where a real
# restart loop looks like the background.
#
# on-failure restarts a CRASH, which is what restarting is for, and leaves a
# clean exit alone. The timer beside this file starts each session.
#
# StartLimit caps a genuine loop. A non-zero exit that keeps repeating -- a
# preflight failure with a missing key, say -- gives up after 5 tries in 10
# minutes and enters failed state, where `systemctl status` says so, instead of
# retrying forever in silence.
#
# Restarting is safe at all because the halt is durable: a breaker trip writes
# both atlas_state.mode=PAUSED and a sentinel file outside the repo, so a
# restarted process reads the halt and refuses rather than resuming into the
# failure that caused it. An in-memory-only breaker would be erased here.

[Unit]
Description=ATLAS market-hours entry engine (09:20-15:20 IST, 60s cycle)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/thestocklogic
Environment=PYTHONUNBUFFERED=1

# Every secret is read from the environment, and until now the environment came
# from the crontab header. systemd does not read a crontab, so without this
# file the service starts with none of them: no ledger key, no broker, and --
# the quiet one -- no Telegram, which means every alert for the session goes
# nowhere while nothing reports a failure. preflight() refuses to start rather
# than run deaf. Copy deploy/atlas.env.example, chmod 600, fill it in.
EnvironmentFile=/etc/atlas.env

# Outside the repo: the box deploys with `git reset --hard`, and the halt must
# outlive a deploy as well as a restart.
Environment=ATLAS_HALT_FILE=/var/lib/atlas/halt
Environment=ATLAS_LOCK_FILE=/var/lib/atlas/market_hours.lock
RuntimeDirectory=atlas
StateDirectory=atlas

ExecStart=/home/ubuntu/thestocklogic/venv/bin/python -m atlas.signal.market_open

Restart=on-failure
RestartSec=60
StartLimitIntervalSec=600
StartLimitBurst=5

# A kill must not land between the order and the row it is recorded in. SIGTERM
# lets the current cycle finish; the two-phase write means even a SIGKILL here
# leaves a PENDING row that the next startup reconciles rather than a position
# nothing knows about.
KillSignal=SIGTERM
TimeoutStopSec=90

StandardOutput=journal
StandardError=journal

# NO [Install] SECTION, DELIBERATELY.
#
# This unit is started by atlas-market-hours.timer, not by boot. It had
# WantedBy=multi-user.target, which meant every reboot started a session
# regardless of the hour -- the engine would come up at 22:00, find the window
# closed, and exit, which is the same pointless churn Restart=always caused.
#
# `systemctl enable atlas-market-hours.service` now fails with "no installation
# config", which is the correct answer: enable the TIMER. Starting it by hand
# still works and is how Monday's first session is meant to begin.
