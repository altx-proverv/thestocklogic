# Starts the ATLAS market-hours engine once each weekday morning.
#
#   sudo systemctl enable --now atlas-market-hours.timer
#   systemctl list-timers atlas-market-hours.timer
#
# WHY A TIMER AND NOT Restart=always
# ----------------------------------
# The service exits 0 when the window closes -- done for the day, not crashed.
# Restart=always read that as a reason to start it again, so outside market
# hours it span around the clock: start, window closed, exit, restart. The
# churn was harmless on its own and corrosive in aggregate, because a journal
# full of routine restarts is one where a real restart loop is invisible.
#
# So the service restarts only on failure, and this decides when a session
# begins. Systemd is still the only scheduler; this is not the cron coming
# back.
#
# The schedule is written in IST because the window is. The box runs Etc/UTC,
# and this was previously spelled out as 03:50 UTC with a note explaining the
# conversion -- correct, and one more place where a reader has to do the
# arithmetic to check it against WINDOW_START. systemd on the box is 259 and
# takes the timezone directly, so it says what it means.
#
# Needs systemd 252+. On an older one the timezone suffix is a parse error and
# the timer silently never fires, so check `systemctl --version` before moving
# this file to another machine.
#
# It fires AT the open rather than before it. The service refuses to run
# outside the window, so an early start used to mean the process came up, found
# the window closed and exited before the session began. serve() now waits for
# the open instead, which makes an early start harmless rather than a wasted
# morning -- but the timer still aims at 09:20 so the common path needs no wait.
#
# Mon-Fri cannot see NSE holidays; in_window() checks the trading calendar for
# that. Diwali is a Thursday.

[Unit]
Description=Start the ATLAS market-hours engine at 09:20 IST on trading days
Requires=atlas-market-hours.service

[Timer]
OnCalendar=Mon-Fri 09:20 Asia/Kolkata
AccuracySec=30s

# If the box was down when the timer should have fired, run it on boot. Safe
# because the service re-checks the window and the calendar itself: a late fire
# outside hours exits 0 immediately, and a late fire inside hours picks up the
# rest of the session, which is what you would want.
Persistent=true

Unit=atlas-market-hours.service

[Install]
WantedBy=timers.target
